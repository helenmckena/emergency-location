# Скопируйте в .env.local (локально) или добавьте в Vercel → Settings → Environment Variables.

# false = работаем с настоящим бэкендом (карта на двух устройствах);
# по умолчанию включён демо-режим без сервера
VITE_DEMO_MODE=false

# адрес бэкенда: локально http://localhost:8000, на Render https://ваш-сервис.onrender.com
VITE_API_URL=http://localhost:8000
