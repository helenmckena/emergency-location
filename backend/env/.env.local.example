# Скопируйте в env/.env (файл читается автоматически)
DB__DSN=sqlite+aiosqlite:///./local.db
# публичный адрес бэкенда (нужен для ссылок на фото), без слеша в конце
SERVER__DOMAIN=http://localhost:8000
# пауза между заявками на один номер, секунды (0 = без паузы, удобно для демо)
LOCATION__NEXT_REQUEST_WAIT=0
